<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pocket Music" Width="1180" Height="760" MinWidth="980" MinHeight="640" Background="#080809" Foreground="#E6E1EB" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#49414F" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E6E1EB"/><Setter Property="Background" Value="#292530"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Foreground="#E6E1EB" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#292530" CornerRadius="12" Padding="12"><DockPanel><TextBlock Text="⌄" DockPanel.Dock="Right" Foreground="#CEC1FF"/><ContentPresenter TextElement.Foreground="#E6E1EB" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/></DockPanel></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#302A3B" CornerRadius="12" Padding="8" MinWidth="230"><StackPanel IsItemsHost="True"/></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E6E1EB"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E1EB"/></Style>
  <Style TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="#E2DDF2"/><Setter Property="Background" Value="#24232B"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#CEC1FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#ECE6F0"/><Setter Property="Background" Value="#24232B"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C6BFCF"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#E6E1EB"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Name="Row" CornerRadius="16" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#222129"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#373144"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="TrackRow">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
    <Border Width="54" Height="54" CornerRadius="10" Background="#373144">
     <Grid>
      <Viewbox Width="23" Height="23"><Path Data="{DynamicResource music_note}" Fill="#CBBBED"/></Viewbox>
      <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
      <Border Background="#992B1F3D" CornerRadius="10" Visibility="{Binding IsActiveRow, FallbackValue=Collapsed}">
       <TextBlock Text="▶" Foreground="#CEC1FF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </Grid>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
     <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Subtitle}" Foreground="#B8B1C3" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#BBB4C7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Name="RowPlayNext" Content="⤴" ToolTip="Play next" Padding="6,4" FontSize="11" Margin="2,0" Background="#2B2635"/>
     <Button Name="RowEnqueue" Content="+" ToolTip="Add to queue" Padding="7,4" FontSize="12" Margin="2,0" Background="#2B2635"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="HomeTrackTile">
   <Border Background="#201C29" CornerRadius="16" Padding="14,16" Margin="0,0,8,0"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
    <Border Width="44" Height="44" Background="#3B324D" CornerRadius="10"><Viewbox Width="21" Height="21"><Path Data="{DynamicResource music_note}" Fill="#CEC1FF"/></Viewbox></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0"><TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#A99BB9" Margin="0,5,0,0"/></StackPanel>
    <Button Name="RecentPlay" Grid.Column="2" Content="▶" ToolTip="Play this local track" AutomationProperties.Name="Play this local track" Padding="8,7" Background="#40334F" VerticalAlignment="Center"/>
   </Grid></Border>
  </DataTemplate>
  <DataTemplate x:Key="SearchTrackRow">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
    <Border Width="50" Height="50" CornerRadius="10" Background="#373144">
     <Grid>
      <Viewbox Width="23" Height="23"><Path Data="{DynamicResource music_note}" Fill="#CBBBED"/></Viewbox>
      <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
      <Border Background="#992B1F3D" CornerRadius="10" Visibility="{Binding IsActiveRow, FallbackValue=Collapsed}">
       <TextBlock Text="▶" Foreground="#CEC1FF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </Grid>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
     <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Subtitle}" Foreground="#B8B1C3" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#BBB4C7" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Name="PreviewResult" Content="▶ Preview" ToolTip="Play with YouTube without downloading" Padding="8,6" FontSize="11" Margin="3,0" VerticalAlignment="Center"/>
     <Button Name="LocalResult" Content="Local" IsEnabled="{Binding LocalAvailable, FallbackValue=False}" Padding="6,6" FontSize="11" Margin="2,0" ToolTip="Play downloaded audio from folder"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LocalAvailable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Name="DownloadResult" Content="↓ Save" Padding="8,6" FontSize="11" Margin="2,0" ToolTip="Choose download format and folder"/>
     <Button Name="SearchPlayNext" Content="⤴" ToolTip="Play next" Padding="5,4" FontSize="11" Margin="2,0" Background="#2B2635"/>
     <Button Name="SearchEnqueue" Content="+" ToolTip="Add to queue" Padding="6,4" FontSize="12" Margin="2,0" Background="#2B2635"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="QueueTrackRow">
   <Grid Margin="0,2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding DisplayIndex}" Foreground="#AFA7BB" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
     <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TextColor, FallbackValue='#E6E1EB'}" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#958A9F" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#958A9F" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Name="QueueMoveUp" Content="▲" ToolTip="Move up" Padding="4,2" FontSize="10" Margin="1,0" Background="Transparent" Foreground="#AFA7BB"/>
     <Button Name="QueueMoveDown" Content="▼" ToolTip="Move down" Padding="4,2" FontSize="10" Margin="1,0" Background="Transparent" Foreground="#AFA7BB"/>
     <Button Name="QueueRemove" Content="✕" ToolTip="Remove from queue" Padding="5,2" FontSize="10" Margin="2,0" Background="Transparent" Foreground="#D48B97"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <Grid Background="#0D0C10">
  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/><ColumnDefinition Name="DownloadColumn" Width="0"/></Grid.ColumnDefinitions>
  <!-- Left Navigation -->
  <Border Background="#121115" Padding="12,25">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="♫" FontSize="36" Foreground="#CEC1FF" HorizontalAlignment="Center" Margin="0,0,0,34"/>
     <Button Name="HomeNav" Background="#40394F" Padding="19,12" ToolTip="Home"><Viewbox Width="24" Height="24"><Path Data="{DynamicResource home_outlined}" Fill="#DED4F7"/></Viewbox></Button>
     <TextBlock Text="Home" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,25"/>
     <Button Name="SearchNav" Padding="19,12" ToolTip="Search"><Viewbox Width="24" Height="24"><Path Data="{DynamicResource search}" Fill="#DED4F7"/></Viewbox></Button>
     <TextBlock Text="Search" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,25"/>
     <Button Name="LibraryNav" Padding="19,12" ToolTip="Saved audio"><Viewbox Width="24" Height="24"><Path Data="{DynamicResource library_music_outlined}" Fill="#DED4F7"/></Viewbox></Button>
     <TextBlock Text="Library" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,25"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Pocket&#10;Music" TextAlignment="Center" Foreground="#8C8498" FontSize="11" VerticalAlignment="Bottom"/>
   </DockPanel>
  </Border>

  <!-- Center Content Area -->
  <Grid Grid.Column="1" Margin="30,28,28,24" MaxWidth="1440">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,24">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Name="KeyboardHelp" Content="?" Padding="13,8" Margin="0,0,8,0" ToolTip="Keyboard shortcuts" AutomationProperties.Name="Keyboard shortcuts"/><Button Name="ToggleDownloads" Content="Downloads" Padding="16,9" ToolTip="Download settings (Ctrl+D)"/></StackPanel>
    <TextBlock Name="PageTitle" Text="Home" FontSize="30" FontWeight="SemiBold"/>
   </DockPanel>
   <Border Grid.Row="1" Background="#25232C" CornerRadius="28" Padding="8" Margin="0,0,0,24">
    <DockPanel>
     <Button Name="SearchGo" Content="Search" DockPanel.Dock="Right" Background="#CEC1FF" Foreground="#292038"/>
     <Grid>
      <TextBox Name="Query" ToolTip="Search YouTube for a song or artist (Ctrl+K)" AutomationProperties.Name="Search songs, artists or a YouTube link" Background="Transparent" VerticalContentAlignment="Center" Text=""/>
      <TextBlock Text="Search songs, artists, or paste a link" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#A99EBB">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
    </DockPanel>
   </Border>
   <Grid Grid.Row="2">
    <!-- Home Page -->
    <ScrollViewer Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Border CornerRadius="24" Background="#211D2B" BorderBrush="#38313F" BorderThickness="1" Margin="0,0,0,26">
       <Grid MinHeight="220">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="28,20" VerticalAlignment="Center">
         <TextBlock Text="A SPACE FOR YOUR SOUND" FontSize="10" FontWeight="SemiBold" Foreground="#C4B4E8" Margin="0,0,0,12"/>
         <TextBlock Text="Press play on&#10;something new." FontSize="32" FontWeight="SemiBold" LineHeight="38" TextWrapping="Wrap"/>
         <TextBlock Text="Discover a song. Keep the ones you love." FontSize="13" Foreground="#BDB2CA" TextWrapping="Wrap" Margin="0,10,0,12"/>
         <WrapPanel><Button Name="HeroBrowse" Content="Find music  →" Background="#CEC1FF" Foreground="#251C35" Padding="18,9" Margin="0,0,8,0"/><Button Name="HeroLibrary" Content="Open library" Background="#302A3B" Padding="16,9" Margin="0,0,0,0"/></WrapPanel>
        </StackPanel>
        <Border Name="HomeHeroArt" Grid.Column="1" CornerRadius="0,24,24,0" Background="#1C1A20"/>
       </Grid>
      </Border>

      <DockPanel Margin="0,0,0,14"><Button Name="ShowLibrary" Content="View library  →" DockPanel.Dock="Right" Padding="14,7"/><TextBlock Text="Recently saved" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="On this PC" Foreground="#978DA5" FontSize="12" Margin="14,0" VerticalAlignment="Center"/></DockPanel>
      <Border Name="RecentEmpty" Background="#19171F" CornerRadius="18" Padding="22" Margin="0,0,0,20"><DockPanel><Button Name="HomeChooseFolder" Content="Choose music folder" DockPanel.Dock="Right" VerticalAlignment="Center" Background="#30283E"/><StackPanel Margin="0,0,16,0"><TextBlock Text="Make yourself at home" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Bring your local audio into the library to find it here." TextWrapping="Wrap" Foreground="#AFA7BB" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
      <ListBox Name="RecentTracks" Tag="3" ItemTemplate="{StaticResource HomeTrackTile}" Margin="-8,0,-8,26" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>

      <DockPanel Margin="0,0,0,14">
       <TextBlock Name="HomeLibraryCount" DockPanel.Dock="Right" Foreground="#978DA5" FontSize="12" VerticalAlignment="Center" Text="Your local collection"/>
       <TextBlock Text="Find your flow" FontSize="22" FontWeight="SemiBold"/>
      </DockPanel>
      <WrapPanel Margin="0,0,0,18">
       <Button Name="MoodEnergize" Content="↗  Energize" Margin="0,0,8,8" Padding="16,9"/>
       <Button Name="MoodWorkout" Content="⚡  Workout" Margin="0,0,8,8" Padding="16,9"/>
       <Button Name="MoodRelax" Content="☾  Relax" Margin="0,0,8,8" Padding="16,9"/>
       <Button Name="MoodFeelGood" Content="♡  Feel good" Margin="0,0,8,8" Padding="16,9"/>
      </WrapPanel>
      <UniformGrid Columns="3" Margin="0,0,0,26">
       <Button Name="DiscoverPiano" ToolTip="Search quiet piano music" Padding="0" Margin="0,0,12,0" HorizontalContentAlignment="Stretch" Background="#1C1923">
        <StackPanel>
         <Border Height="128" CornerRadius="20" ClipToBounds="True" Background="#332B45">
          <Grid>
           <Viewbox Stretch="UniformToFill"><Canvas Width="360" Height="140" ClipToBounds="True">
            <Ellipse Width="126" Height="126" Fill="#514269" Canvas.Left="225" Canvas.Top="-40"/>
            <Ellipse Width="76" Height="76" Fill="#B5A1DA" Canvas.Left="250" Canvas.Top="-12"/>
            <Ellipse Width="70" Height="70" Fill="#332B45" Canvas.Left="232" Canvas.Top="-20"/>
            <Canvas Canvas.Left="80" Canvas.Top="42"><Canvas.RenderTransform><RotateTransform Angle="-17"/></Canvas.RenderTransform>
             <Rectangle Width="230" Height="130" RadiusX="9" RadiusY="9" Fill="#19151F"/>
             <Rectangle Canvas.Left="8" Canvas.Top="7" Width="28" Height="110" RadiusX="3" Fill="#E6DDED"/><Rectangle Canvas.Left="40" Canvas.Top="7" Width="28" Height="110" RadiusX="3" Fill="#CFC1DE"/><Rectangle Canvas.Left="72" Canvas.Top="7" Width="28" Height="110" RadiusX="3" Fill="#E6DDED"/><Rectangle Canvas.Left="104" Canvas.Top="7" Width="28" Height="110" RadiusX="3" Fill="#CFC1DE"/><Rectangle Canvas.Left="136" Canvas.Top="7" Width="28" Height="110" RadiusX="3" Fill="#E6DDED"/><Rectangle Canvas.Left="168" Canvas.Top="7" Width="28" Height="110" RadiusX="3" Fill="#CFC1DE"/><Rectangle Canvas.Left="200" Canvas.Top="7" Width="22" Height="110" RadiusX="3" Fill="#E6DDED"/>
             <Rectangle Canvas.Left="29" Canvas.Top="7" Width="16" Height="62" Fill="#211A2C"/><Rectangle Canvas.Left="61" Canvas.Top="7" Width="16" Height="62" Fill="#211A2C"/><Rectangle Canvas.Left="125" Canvas.Top="7" Width="16" Height="62" Fill="#211A2C"/><Rectangle Canvas.Left="157" Canvas.Top="7" Width="16" Height="62" Fill="#211A2C"/><Rectangle Canvas.Left="189" Canvas.Top="7" Width="16" Height="62" Fill="#211A2C"/>
            </Canvas>
           </Canvas></Viewbox>
           <TextBlock Text="SLOW DOWN" Foreground="#E0D2F2" FontSize="10" FontWeight="SemiBold" Margin="16" VerticalAlignment="Top"/>
          </Grid>
         </Border>
         <DockPanel Margin="16,13,16,0"><TextBlock DockPanel.Dock="Right" Text="↗" Foreground="#BDA9DE"/><TextBlock Text="Quiet piano" FontSize="17" FontWeight="SemiBold"/></DockPanel>
         <TextBlock Text="A little room to breathe" FontSize="12" Foreground="#AFA2C0" Margin="16,5,16,16"/>
        </StackPanel>
       </Button>
       <Button Name="DiscoverJazz" ToolTip="Search jazz session music" Padding="0" Margin="0,0,12,0" HorizontalContentAlignment="Stretch" Background="#211B18">
        <StackPanel>
         <Border Height="128" CornerRadius="20" ClipToBounds="True" Background="#493528"><Grid>
          <Viewbox Stretch="UniformToFill"><Canvas Width="360" Height="140" ClipToBounds="True">
           <Rectangle Width="120" Height="180" Fill="#73533A" Canvas.Left="-30" Canvas.Top="-20"><Rectangle.RenderTransform><RotateTransform Angle="-18"/></Rectangle.RenderTransform></Rectangle>
           <Ellipse Width="222" Height="222" Fill="#161515" Canvas.Left="120" Canvas.Top="-14"/>
           <Ellipse Width="192" Height="192" Stroke="#3E332B" StrokeThickness="2" Canvas.Left="135" Canvas.Top="1"/><Ellipse Width="160" Height="160" Stroke="#3E332B" Canvas.Left="151" Canvas.Top="17"/><Ellipse Width="130" Height="130" Stroke="#4B3C30" Canvas.Left="166" Canvas.Top="32"/>
           <Ellipse Width="72" Height="72" Fill="#D2A26B" Canvas.Left="195" Canvas.Top="61"/><Ellipse Width="12" Height="12" Fill="#24201C" Canvas.Left="225" Canvas.Top="91"/>
           <Path Data="M 309,15 L 292,67 L 329,100" Stroke="#D9C3A1" StrokeThickness="5" StrokeStartLineCap="Round"/>
          </Canvas></Viewbox><TextBlock Text="AFTER HOURS" Foreground="#F1D6B1" FontSize="10" FontWeight="SemiBold" Margin="16" VerticalAlignment="Top"/>
         </Grid></Border>
         <DockPanel Margin="16,13,16,0"><TextBlock DockPanel.Dock="Right" Text="↗" Foreground="#D9B17B"/><TextBlock Text="Jazz sessions" FontSize="17" FontWeight="SemiBold"/></DockPanel>
         <TextBlock Text="Settle into the groove" FontSize="12" Foreground="#BEAA95" Margin="16,5,16,16"/>
        </StackPanel>
       </Button>
       <Button Name="DiscoverAcoustic" ToolTip="Search acoustic music" Padding="0" HorizontalContentAlignment="Stretch" Background="#18221F">
        <StackPanel>
         <Border Height="128" CornerRadius="20" ClipToBounds="True" Background="#28413A"><Grid>
          <Viewbox Stretch="UniformToFill"><Canvas Width="360" Height="140" ClipToBounds="True">
           <Ellipse Width="210" Height="230" Fill="#9EAC89" Canvas.Left="140" Canvas.Top="-35"/>
           <Ellipse Width="182" Height="205" Fill="#B7C1A4" Canvas.Left="151" Canvas.Top="-23"/>
           <Ellipse Width="95" Height="95" Fill="#526653" Canvas.Left="193" Canvas.Top="24"/>
           <Ellipse Width="76" Height="76" Fill="#172B25" Canvas.Left="203" Canvas.Top="34"/>
           <Path Data="M 218,-10 L 218,160 M 226,-10 L 226,160 M 234,-10 L 234,160 M 242,-10 L 242,160 M 250,-10 L 250,160 M 258,-10 L 258,160" Stroke="#DFE4CE" StrokeThickness="1.3"/>
           <Path Data="M 27,111 C 60,80 82,141 118,110" Stroke="#789A85" StrokeThickness="3"/>
          </Canvas></Viewbox><TextBlock Text="UNPLUGGED" Foreground="#CEE1CB" FontSize="10" FontWeight="SemiBold" Margin="16" VerticalAlignment="Top"/>
         </Grid></Border>
         <DockPanel Margin="16,13,16,0"><TextBlock DockPanel.Dock="Right" Text="↗" Foreground="#ABCCB4"/><TextBlock Text="Acoustic" FontSize="17" FontWeight="SemiBold"/></DockPanel>
         <TextBlock Text="Warm strings, easy listening" FontSize="12" Foreground="#A1B9AB" Margin="16,5,16,16"/>
        </StackPanel>
       </Button>
      </UniformGrid>

     </StackPanel>
    </ScrollViewer>


    <!-- Search Page -->
    <Grid Name="SearchView" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel>
      <Button Name="SearchCancel" Content="Cancel search" DockPanel.Dock="Right" IsEnabled="False" Padding="12,8"/>
      <TextBlock Text="Search results" FontSize="24" FontWeight="SemiBold"/>
     </DockPanel>
     <TextBlock Grid.Row="1" Name="SearchStatus" Text="Search for a song or artist. Results come from YouTube." Margin="0,12,0,18" TextWrapping="Wrap" Foreground="#BBB2C8"/>
     <Grid Grid.Row="2"><ListBox Name="SearchResults" ItemTemplate="{StaticResource SearchTrackRow}"/><StackPanel Name="SearchEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="24"><TextBlock Text="♪" FontSize="48" Foreground="#CEC1FF" HorizontalAlignment="Center"/><TextBlock Name="SearchEmptyTitle" Text="What would you like to hear?" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,10"/><TextBlock Name="SearchEmptyHint" Text="Search by song or artist. Double-click a result to preview it." Foreground="#ABA1BA" TextWrapping="Wrap" TextAlignment="Center"/><ProgressBar Name="SearchActivity" Visibility="Collapsed" IsIndeterminate="True" Height="3" Margin="40,24" Foreground="#CEC1FF"/></StackPanel></Grid>
    </Grid>

    <!-- Library Page -->
    <Grid Name="LibraryView" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Name="LibraryChangeFolder" Content="Choose folder" Padding="12,8" Margin="0,0,8,0"/><Button Name="RefreshLibrary" Content="Refresh" Padding="14,8"/></StackPanel>
      <TextBlock Text="Saved audio" FontSize="24" FontWeight="SemiBold"/>
     </DockPanel>
     <StackPanel Grid.Row="1" Margin="0,12,0,18"><TextBlock Name="LibraryStatus" Foreground="#BBB2C8" Margin="0,0,0,12" TextWrapping="Wrap"/><DockPanel><Button Name="LibraryClearFilter" Content="Clear" Visibility="Collapsed" DockPanel.Dock="Right" Padding="12,8" Margin="8,0,0,0"/><TextBox Name="LibraryFilter" ToolTip="Filter your library by track name" AutomationProperties.Name="Filter library by track name"/></DockPanel><TextBlock Text="Filter by track name" Foreground="#8F859D" FontSize="11" Margin="2,5,0,0"/></StackPanel>
     <Grid Grid.Row="2"><ListBox Name="LibraryTracks" ItemTemplate="{StaticResource TrackRow}"/><StackPanel Name="LibraryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" Margin="24"><TextBlock Name="LibraryEmptyTitle" Text="Your library starts here" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Name="LibraryEmptyHint" Text="Choose a folder with your audio files." TextAlignment="Center" TextWrapping="Wrap" Foreground="#ABA1BA" Margin="0,12,0,20"/><Button Name="LibraryChooseFolder" Content="Choose music folder" HorizontalAlignment="Center" Background="#CEC1FF" Foreground="#251C35"/></StackPanel></Grid>
     <WrapPanel Grid.Row="3" Margin="0,16,0,0">
      <Button Name="PlayLocal" Content="Play selected" Margin="0,0,8,0" IsEnabled="False"/>
      <Button Name="PlayAllLocal" Content="Play all" Margin="0,0,8,0"/>
      <Button Name="QueueAllLocal" Content="Add all to queue"/>
     </WrapPanel>
    </Grid>

    <!-- Queue Flyout Overlay -->
    <Border Name="QueuePanel" Visibility="Collapsed" Background="#1D1826" BorderBrush="#3D334C" BorderThickness="1" CornerRadius="18" Padding="16" Margin="10">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12">
       <Button Name="QueueClose" Content="✕" DockPanel.Dock="Right" Padding="8,4" Background="Transparent" Foreground="#CEC1FF" FontSize="14"/>
       <TextBlock Text="Play Queue" FontSize="20" FontWeight="SemiBold"/>
      </DockPanel>
      <ListBox Grid.Row="1" Name="QueueList" ItemTemplate="{StaticResource QueueTrackRow}"/>
      <DockPanel Grid.Row="2" Margin="0,12,0,0">
       <Button Name="QueueClear" Content="Clear queue" DockPanel.Dock="Left" Padding="12,6" Background="#362E44" FontSize="12"/>
       <TextBlock Name="QueueCountStatus" Text="0 tracks" Foreground="#AFA7BB" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
     </Grid>
    </Border>

   </Grid>
  </Grid>

  <!-- Right Sidebar: Downloader & Selected Track Details -->
  <Border Name="DownloadPanel" Grid.Column="2" Visibility="Collapsed" Background="#17151B" CornerRadius="24,0,0,24" Padding="20,24,20,20">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <Button Name="CloseDownloads" Content="×" DockPanel.Dock="Right" Padding="9,3" FontSize="18" Background="Transparent" ToolTip="Close download settings" AutomationProperties.Name="Close download settings"/>
      <TextBlock Text="Downloads" FontSize="21" FontWeight="SemiBold"/>
     </DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
     <StackPanel>
     <Border Background="#302A3B" CornerRadius="20" Padding="18" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="SELECTED TRACK" FontSize="10" Foreground="#B9ACD2"/>
       <TextBlock Name="SelectedTitle" Text="Choose a search result" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,8"/>
       <TextBlock Name="SelectedSubtitle" Text="Or paste a video link below" FontSize="12" Foreground="#B9ACD2" TextWrapping="Wrap"/>
       <Button Name="SelectedPreview" Content="▶ Preview play" Margin="0,14,0,0" Padding="12,9" ToolTip="Stream in the YouTube player; no audio download"/>
       <Button Name="SelectedLocal" Content="Play local copy" IsEnabled="False" Margin="0,6,0,0" Padding="12,9" ToolTip="Play downloaded audio from the selected folder"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
      </StackPanel>
     </Border>
      <Expander Header="YouTube video link" Foreground="#C6BFCF" IsExpanded="False" Margin="0,0,0,18">
       <TextBox Name="Url" Margin="0,10,0,0" TextWrapping="Wrap"/>
      </Expander>
      <TextBlock Text="Download format" Foreground="#BEB4CA" Margin="0,0,0,8"/>
      <ComboBox Name="Format" SelectedIndex="0" FontSize="14" Padding="10">
       <ComboBoxItem Content="MP3"/>
       <ComboBoxItem Content="MP4 (video)" ToolTip="Video with audio"/>
       <ComboBoxItem Content="M4A"/>
       <ComboBoxItem Content="Opus"/>
       <ComboBoxItem Content="FLAC"/>
       <ComboBoxItem Content="WAV"/>
      </ComboBox>
      <TextBlock Text="FLAC and WAV cannot restore source quality." TextWrapping="Wrap" Foreground="#8F859D" FontSize="11" Margin="0,8,0,18"/>
      <TextBlock Text="Save to" Foreground="#BEB4CA" Margin="0,0,0,8"/>
      <TextBox Name="Folder" FontSize="12" TextWrapping="Wrap"/>
      <Button Name="Browse" Content="Choose folder" Margin="0,8,0,18"/>
      <CheckBox Name="Permission"><TextBlock Text="I own this content or have permission to download it." TextWrapping="Wrap" Foreground="#C6BFCF" FontSize="12"/></CheckBox>




      <Expander Name="DetailsExpander" Header="Activity details" Foreground="#A69BB6" Margin="0,14,0,0">
       <TextBox Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" Height="110" Margin="0,8,0,0"/>
      </Expander>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
     <Button Name="Start" Content="Download audio" Background="#CEC1FF" Foreground="#251C35" Margin="0,20,0,8"/>
     <Button Name="Cancel" Content="Cancel download" IsEnabled="False" Margin="0,0,0,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
     <ProgressBar Name="Progress" Height="4" Foreground="#CEC1FF" Background="#37303F" Maximum="100" Margin="0,0,0,8"/>
     <TextBlock Name="Status" Text="Ready when you are" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#C8BADB" FontSize="12" Margin="0,0,0,12"/>
     <Button Name="OpenFolder" Content="Open download folder" Padding="12,7" FontSize="12"/>

    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
