<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pocket Music — Metrolist-inspired desktop" Width="1240" Height="850" MinWidth="1060" MinHeight="760" Background="#080809" Foreground="#E6E1EB" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#49414F" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E6E1EB"/><Setter Property="Background" Value="#292530"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#292530" CornerRadius="12" Padding="12"><DockPanel><TextBlock Text="⌄" DockPanel.Dock="Right" Foreground="#CEC1FF"/><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/></DockPanel></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#302A3B" CornerRadius="12" Padding="8" MinWidth="230"><StackPanel IsItemsHost="True"/></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E6E1EB"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E1EB"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E2DDF2"/><Setter Property="Background" Value="#24232B"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#CEC1FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#ECE6F0"/><Setter Property="Background" Value="#24232B"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C6BFCF"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#E6E1EB"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Name="Row" CornerRadius="16" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#222129"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#373144"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="TrackRow"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><Border Width="54" Height="54" CornerRadius="10" Background="#373144"><Grid><Viewbox Width="23" Height="23"><Path Data="{DynamicResource music_note}" Fill="#CBBBED"/></Viewbox><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#B8B1C3" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#BBB4C7" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate>
  <DataTemplate x:Key="SearchTrackRow"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><Border Width="50" Height="50" CornerRadius="10" Background="#373144"><Grid><Viewbox Width="23" Height="23"><Path Data="{DynamicResource music_note}" Fill="#CBBBED"/></Viewbox><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#B8B1C3" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#BBB4C7" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/><StackPanel Grid.Column="3" VerticalAlignment="Center"><Button Name="PreviewResult" Content="▶ Preview" ToolTip="Play with YouTube without downloading" Padding="9,9" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/><Button Name="LocalResult" Content="Play local copy" IsEnabled="{Binding LocalAvailable, FallbackValue=False}" Padding="6,5" FontSize="11" Margin="8,4,0,0" ToolTip="Play downloaded audio from the selected folder"/></StackPanel></Grid></DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/><ColumnDefinition Width="304"/></Grid.ColumnDefinitions>
  <Border Background="#121115" Padding="12,25"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="♫" FontSize="36" Foreground="#CEC1FF" HorizontalAlignment="Center" Margin="0,0,0,34"/><Button Name="HomeNav" Background="#40394F" Padding="19,12" ToolTip="Home"><Viewbox Width="24" Height="24"><Path Data="{DynamicResource home_outlined}" Fill="#DED4F7"/></Viewbox></Button><TextBlock Text="Home" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,25"/><Button Name="SearchNav" Padding="19,12" ToolTip="Search"><Viewbox Width="24" Height="24"><Path Data="{DynamicResource search}" Fill="#DED4F7"/></Viewbox></Button><TextBlock Text="Search" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,25"/><Button Name="LibraryNav" Padding="19,12" ToolTip="Saved audio"><Viewbox Width="24" Height="24"><Path Data="{DynamicResource library_music_outlined}" Fill="#DED4F7"/></Viewbox></Button><TextBlock Text="Library" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,25"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="PC&#10;preview" TextAlignment="Center" Foreground="#8C8498" FontSize="11" VerticalAlignment="Bottom"/></DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,28,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,24"><Border DockPanel.Dock="Right" Background="#24202D" CornerRadius="18" Padding="13,8"><TextBlock Text="YOUR MUSIC, YOUR FILES" FontSize="10" Foreground="#C8BDDC" VerticalAlignment="Center"/></Border><TextBlock Name="PageTitle" Text="Home" FontSize="32"/></DockPanel>
   <Border Grid.Row="1" Background="#25232C" CornerRadius="28" Padding="8" Margin="0,0,0,24"><DockPanel><Button Name="SearchGo" Content="Search" DockPanel.Dock="Right" Background="#CEC1FF" Foreground="#292038"/><Grid><TextBox Name="Query" ToolTip="Search YouTube for a song or artist" Background="Transparent" VerticalContentAlignment="Center" Text=""/><TextBlock Text="Search songs, artists, or paste a link" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#A99EBB"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
   <Grid Grid.Row="2">
    <ScrollViewer Name="HomeView" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Find your next favorite" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Search a song or artist above, or start with a mood." Foreground="#AFA7BB" FontSize="14" Margin="0,0,0,22"/>
     <WrapPanel Margin="0,0,0,28"><Button Name="MoodEnergize" Content="Energize" Margin="0,0,8,8"/><Button Name="MoodWorkout" Content="Workout" Margin="0,0,8,8"/><Button Name="MoodRelax" Content="Relax" Margin="0,0,8,8"/><Button Name="MoodFeelGood" Content="Feel good" Margin="0,0,8,8"/></WrapPanel>
     <TextBlock Text="A little inspiration" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,15"/>
     <UniformGrid Columns="3" Margin="0,0,0,28">
      <Button Name="DiscoverPiano" Padding="0" Margin="0,0,10,0" HorizontalContentAlignment="Stretch"><StackPanel><Border Height="132" Width="156" CornerRadius="20"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#51416F" Offset="0"/><GradientStop Color="#201A34" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="☾" FontSize="58" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#DED0F7"/></Border><TextBlock Text="Quiet piano" FontSize="16" FontWeight="SemiBold" Margin="10,12,0,4"/><TextBlock Text="Search to unwind" FontSize="11" Foreground="#BEB3CD" Margin="10,0,0,14"/></StackPanel></Button>
      <Button Name="DiscoverJazz" Padding="0" Margin="0,0,10,0"><StackPanel><Border Height="132" Width="156" CornerRadius="20"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#765B42" Offset="0"/><GradientStop Color="#36251F" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="♪" FontSize="66" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F6D7B7"/></Border><TextBlock Text="Jazz sessions" FontSize="16" FontWeight="SemiBold" Margin="10,12,0,4"/><TextBlock Text="Find your rhythm" FontSize="11" Foreground="#BEB3CD" Margin="10,0,0,14"/></StackPanel></Button>
      <Button Name="DiscoverAcoustic" Padding="0"><StackPanel><Border Height="132" Width="156" CornerRadius="20"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#40625C" Offset="0"/><GradientStop Color="#162D2C" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="≈" FontSize="68" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C2E4D9"/></Border><TextBlock Text="Acoustic" FontSize="16" FontWeight="SemiBold" Margin="10,12,0,4"/><TextBlock Text="Keep it simple" FontSize="11" Foreground="#BEB3CD" Margin="10,0,0,14"/></StackPanel></Button>
     </UniformGrid>
     <DockPanel Margin="0,0,0,12"><Button Name="ShowLibrary" Content="View all" DockPanel.Dock="Right" Padding="14,7"/><TextBlock Text="On your PC" FontSize="23" FontWeight="SemiBold"/></DockPanel>
     <TextBlock Name="RecentEmpty" Text="Your saved audio will appear here. Choose a folder to explore it." TextWrapping="Wrap" Foreground="#AFA7BB" Margin="0,8,0,14"/>
     <ListBox Name="RecentTracks" ItemTemplate="{StaticResource TrackRow}" MaxHeight="215"/>
     <TextBlock Text="Built with adapted Metrolist resources • Independent desktop prototype" FontSize="10" Foreground="#827A8E" Margin="0,20,0,0" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <Grid Name="SearchView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button Name="SearchCancel" Content="Cancel search" DockPanel.Dock="Right" IsEnabled="False" Padding="12,8"/><TextBlock Text="Search results" FontSize="24" FontWeight="SemiBold"/></DockPanel><TextBlock Grid.Row="1" Name="SearchStatus" Text="Search for a song or artist. Results come from YouTube." Margin="0,12,0,18" TextWrapping="Wrap" Foreground="#BBB2C8"/><ListBox Grid.Row="2" Name="SearchResults" ItemTemplate="{StaticResource SearchTrackRow}"/></Grid>
    <Grid Name="LibraryView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button Name="RefreshLibrary" Content="Refresh" DockPanel.Dock="Right" Padding="14,8"/><TextBlock Text="Saved audio" FontSize="24" FontWeight="SemiBold"/></DockPanel><TextBlock Grid.Row="1" Name="LibraryStatus" Foreground="#BBB2C8" Margin="0,12,0,18" TextWrapping="Wrap"/><ListBox Grid.Row="2" Name="LibraryTracks" ItemTemplate="{StaticResource TrackRow}"/><Button Grid.Row="3" Name="PlayLocal" Content="Play selected in Pocket Music" Margin="0,16,0,0" IsEnabled="False"/></Grid>
   </Grid>
  </Grid>
  <Border Grid.Column="2" Background="#17151B" CornerRadius="28,0,0,28" Padding="23,28,23,24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><DockPanel><Viewbox DockPanel.Dock="Right" Width="22" Height="22"><Path Data="{DynamicResource download}" Fill="#CEC1FF"/></Viewbox><TextBlock Text="Save your music" FontSize="21" FontWeight="SemiBold"/></DockPanel><Border Background="#302A3B" CornerRadius="20" Padding="18" Margin="0,24,0,20"><StackPanel><TextBlock Text="SELECTED TRACK" FontSize="10" Foreground="#B9ACD2"/><TextBlock Name="SelectedTitle" Text="Choose a search result" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,8"/><TextBlock Name="SelectedSubtitle" Text="Or paste a video link below" FontSize="12" Foreground="#B9ACD2" TextWrapping="Wrap"/><Button Name="SelectedPreview" Content="▶ Preview play" Margin="0,14,0,0" Padding="12,9" ToolTip="Stream in the YouTube player; no audio download"/><Button Name="SelectedLocal" Content="Play local copy" IsEnabled="False" Margin="0,6,0,0" Padding="12,9" ToolTip="Play downloaded audio from the selected folder"/></StackPanel></Border></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><Expander Header="YouTube video link" Foreground="#C6BFCF" IsExpanded="False" Margin="0,0,0,18"><TextBox Name="Url" Margin="0,10,0,0" TextWrapping="Wrap"/></Expander><TextBlock Text="Download format" Foreground="#BEB4CA" Margin="0,0,0,8"/><ComboBox Name="Format" SelectedIndex="0" FontSize="14" Padding="10"><ComboBoxItem Content="MP3"/><ComboBoxItem Content="MP4 (video)" ToolTip="Video with audio"/><ComboBoxItem Content="M4A"/><ComboBoxItem Content="Opus"/><ComboBoxItem Content="FLAC"/><ComboBoxItem Content="WAV"/></ComboBox><TextBlock Text="FLAC and WAV cannot restore source quality." TextWrapping="Wrap" Foreground="#8F859D" FontSize="11" Margin="0,8,0,18"/><TextBlock Text="Save to" Foreground="#BEB4CA" Margin="0,0,0,8"/><TextBox Name="Folder" FontSize="12" TextWrapping="Wrap"/><Button Name="Browse" Content="Choose folder" Margin="0,8,0,18"/><CheckBox Name="Permission"><TextBlock Text="I own this content or have permission to download it." TextWrapping="Wrap" Foreground="#C6BFCF" FontSize="12"/></CheckBox><Button Name="Start" Content="Download audio" Background="#CEC1FF" Foreground="#251C35" Margin="0,20,0,8"/><Button Name="Cancel" Content="Cancel download" IsEnabled="False"/><ProgressBar Name="Progress" Height="5" Foreground="#CEC1FF" Background="#37303F" Maximum="100" Margin="0,18,0,12"/><TextBlock Name="Status" Text="Ready when you are" TextWrapping="Wrap" Foreground="#C8BADB"/><Expander Name="DetailsExpander" Header="Activity details" Foreground="#A69BB6" Margin="0,14,0,0"><TextBox Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" Height="110" Margin="0,8,0,0"/></Expander></StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,16,0,0"><Button Name="OpenFolder" Content="Open folder"/><TextBlock Text="Ordinary audio files. No account required.&#10;Public, authorized content only." TextWrapping="Wrap" Foreground="#8F859D" FontSize="10" Margin="0,12,0,0"/></StackPanel>
  </Grid></Border>
 </Grid>
</Window>
