<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pocket Music" Width="1440" Height="900" MinWidth="980" MinHeight="640" Background="#0B101B" Foreground="#F1F5FF" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#42516A" CornerRadius="3" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F1F5FF" />
      <Setter Property="Background" Value="#223049" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Foreground="#F1F5FF" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="#223049" CornerRadius="12" Padding="12">
                      <DockPanel>
                        <TextBlock Text="⌄" DockPanel.Dock="Right" Foreground="#C9DFFF" />
                        <ContentPresenter TextElement.Foreground="#F1F5FF" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                      </DockPanel>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                <Border Background="#223049" CornerRadius="12" Padding="8" MinWidth="230">
                  <StackPanel IsItemsHost="True" />
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F1F5FF" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F1F5FF" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Foreground" Value="#F1F5FF" />
      <Setter Property="Background" Value="#223049" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.78" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.35" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#C9DFFF" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F1F5FF" />
      <Setter Property="Background" Value="#223049" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#B7C5DA" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#F1F5FF" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Name="Row" CornerRadius="16" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#223049" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#303F59" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="TrackRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="66" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="54" />
          <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>
        <Border Width="54" Height="54" CornerRadius="10" Background="#303F59">
          <Grid>
            <Viewbox Width="23" Height="23">
              <Path Data="{DynamicResource music_note}" Fill="#C9DFFF" />
            </Viewbox>
            <Image Tag="TrackArtwork" Stretch="UniformToFill" />
            <Border Background="#992B1F3D" CornerRadius="10" Visibility="{Binding IsActiveRow, FallbackValue=Collapsed}">
              <TextBlock Text="▶" Foreground="#C9DFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" Foreground="#B7C5DA" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#B7C5DA" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <Button Grid.Column="3" Name="RowMore" Content="⋯" FontSize="21" Background="Transparent" Padding="10,4" Width="42" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Track options" AutomationProperties.Name="Track options" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="HomeTrackTile">
      <Border Background="#172133" CornerRadius="16" Padding="14,16" Margin="0,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" Background="#303F59" CornerRadius="10">
            <Grid>
              <Viewbox Width="21" Height="21">
                <Path Data="{DynamicResource music_note}" Fill="#C9DFFF" />
              </Viewbox>
              <Image Tag="TrackArtwork" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
            <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#B7C5DA" Margin="0,5,0,0" />
          </StackPanel>
          <Button Name="RecentPlay" Grid.Column="2" Content="▶" ToolTip="Play this local track" AutomationProperties.Name="Play this local track" Padding="8,7" Background="#303F59" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="SearchTrackRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="45" />
          <ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>
        <Border Width="50" Height="50" CornerRadius="10" Background="#303F59">
          <Grid>
            <Viewbox Width="23" Height="23">
              <Path Data="{DynamicResource music_note}" Fill="#C9DFFF" />
            </Viewbox>
            <Image Tag="TrackArtwork" Stretch="UniformToFill" />
            <Border Background="#992B1F3D" CornerRadius="10" Visibility="{Binding IsActiveRow, FallbackValue=Collapsed}">
              <TextBlock Text="▶" Foreground="#C9DFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" Foreground="#B7C5DA" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#B7C5DA" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Name="PreviewResult" Content="▶ Preview" ToolTip="Play with YouTube without downloading" Padding="8,6" FontSize="11" Margin="3,0" VerticalAlignment="Center" />
          <Button Name="LocalResult" Content="Local" IsEnabled="{Binding LocalAvailable, FallbackValue=False}" Padding="6,6" FontSize="11" Margin="2,0" ToolTip="Play downloaded audio from folder">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding LocalAvailable}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Name="DownloadResult" Content="↓ Save" Padding="8,6" FontSize="11" Margin="2,0" ToolTip="Choose download format and folder" />
          <Button Name="SearchPlayNext" Content="⤴" ToolTip="Play next" Padding="5,4" FontSize="11" Margin="2,0" Background="#223049" />
          <Button Name="SearchEnqueue" Content="+" ToolTip="Add to queue" Padding="6,4" FontSize="12" Margin="2,0" Background="#223049" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="QueueTrackRow">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="50" />
          <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding DisplayIndex}" Foreground="#B7C5DA" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TextColor, FallbackValue='#F1F5FF'}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#B7C5DA" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#B7C5DA" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Name="QueueMoveUp" Content="▲" ToolTip="Move up" Padding="4,2" FontSize="10" Margin="1,0" Background="Transparent" Foreground="#B7C5DA" />
          <Button Name="QueueMoveDown" Content="▼" ToolTip="Move down" Padding="4,2" FontSize="10" Margin="1,0" Background="Transparent" Foreground="#B7C5DA" />
          <Button Name="QueueRemove" Content="✕" ToolTip="Remove from queue" Padding="5,2" FontSize="10" Margin="2,0" Background="Transparent" Foreground="#D48B97" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <SolidColorBrush x:Key="MoodCalm" Color="#29443F" />
    <SolidColorBrush x:Key="MoodEnergy" Color="#543B37" />
    <SolidColorBrush x:Key="MoodFocus" Color="#303A61" />
    <SolidColorBrush x:Key="MoodNight" Color="#493554" />
    <SolidColorBrush x:Key="AppBackground" Color="#0B101B" />
    <SolidColorBrush x:Key="PanelBackground" Color="#111A29" />
    <SolidColorBrush x:Key="CardBackground" Color="#172133" />
    <SolidColorBrush x:Key="RaisedBackground" Color="#223049" />
    <SolidColorBrush x:Key="AccentBrush" Color="#C9DFFF" />
    <SolidColorBrush x:Key="PrimaryText" Color="#F1F5FF" />
    <SolidColorBrush x:Key="SecondaryText" Color="#B7C5DA" />
    <Thickness x:Key="PageInset">24</Thickness>
    <CornerRadius x:Key="PanelRadius">12</CornerRadius>
    <Style x:Key="SidebarEntry" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <DataTemplate x:Key="SidebarTrack">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="6" Background="{StaticResource RaisedBackground}">
          <Image Tag="TrackArtwork" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="AlbumCard">
      <Button Name="AlbumPlay" Padding="10" Margin="0,0,10,10" Background="{StaticResource CardBackground}" HorizontalContentAlignment="Stretch" ToolTip="Play this saved track">
        <StackPanel>
          <Grid>
            <Border Height="132" CornerRadius="10" Background="{StaticResource RaisedBackground}">
              <Image Tag="TrackArtwork" Stretch="UniformToFill" />
            </Border>
            <Border Background="{StaticResource AccentBrush}" CornerRadius="20" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
              <TextBlock Text="▶" Foreground="{StaticResource AppBackground}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,12,0,4" ToolTip="{Binding Title}" />
          <TextBlock Text="Saved for offline listening" Foreground="{StaticResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Grid Name="DesktopLayout" Background="{StaticResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Name="NavigationColumn" Width="248" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Name="DownloadColumn" Width="0" />
      <ColumnDefinition Name="NowPlayingColumn" Width="0" />
    </Grid.ColumnDefinitions>
    <!-- Global navigation, independent of the current listening or browsing page. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
      <Border Background="{StaticResource AccentBrush}" CornerRadius="12" Width="34" Height="34">
        <Viewbox Width="21" Height="21">
          <Path Data="{DynamicResource music_note}" Fill="{StaticResource AppBackground}" />
        </Viewbox>
      </Border>
      <TextBlock Name="SidebarBrand" Text="Pocket Music" FontSize="18" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <DockPanel Grid.Column="1" Grid.ColumnSpan="3" Margin="8,0,16,0" VerticalAlignment="Center">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
        <Button Name="KeyboardHelp" Content="?" Width="34" Height="38" Padding="0" Background="Transparent" ToolTip="Keyboard shortcuts" AutomationProperties.Name="Keyboard shortcuts" />
        <Button Name="ToggleNowPlaying" Content="Now playing" Margin="6,0" Padding="12,8" ToolTip="Show or hide the now-playing panel" />
          <Button Name="YouTubeConnection" Content="Connect YouTube" Padding="12,8" Margin="0,0,6,0" ToolTip="Import an encrypted YouTube-only session" />
          <Button Name="ToggleDownloads" Content="Downloads" Padding="14,8" ToolTip="Download settings (Ctrl+D)" />
      </StackPanel>
      <Border Name="SearchBar" MaxWidth="620" HorizontalAlignment="Stretch" Background="{StaticResource RaisedBackground}" CornerRadius="24" Padding="4">
        <DockPanel>
          <Button Name="SearchGo" DockPanel.Dock="Right" Content="Search" Padding="14,8" Background="{StaticResource AccentBrush}" Foreground="{StaticResource AppBackground}" />
          <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="24" Margin="12,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" />
          <Grid>
            <TextBox Name="Query" Background="Transparent" Padding="10" VerticalContentAlignment="Center" AutomationProperties.Name="Search songs, artists or a YouTube link" ToolTip="Search music (Ctrl+K)" />
            <TextBlock Text="What would you like to hear?" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=Query}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
      </Border>
    </DockPanel>
    <Popup Name="SearchSuggestionPopup" PlacementTarget="{Binding ElementName=SearchBar}" Placement="Bottom" AllowsTransparency="True" StaysOpen="True">
      <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="8" Width="430">
        <ListBox Name="SearchSuggestions" MaxHeight="210" Visibility="Collapsed" AutomationProperties.Name="Search suggestions" />
      </Border>
    </Popup>
    <!-- The library remains at hand while browsing, as on a desktop music client. -->
    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="{StaticResource PanelRadius}" Margin="8,0,0,8" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <Button Name="HomeNav" Style="{StaticResource SidebarEntry}" Background="{StaticResource RaisedBackground}" ToolTip="Home">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="21" Height="21" Margin="0,0,12,0">
                <Path Data="{DynamicResource home_outlined}" Fill="{StaticResource AccentBrush}" />
              </Viewbox>
              <TextBlock Text="Home" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Name="SearchNav" Style="{StaticResource SidebarEntry}" ToolTip="Search (Ctrl+K)">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="21" Height="21" Margin="0,0,12,0">
                <Path Data="{DynamicResource search}" Fill="{StaticResource SecondaryText}" />
              </Viewbox>
              <TextBlock Text="Search" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Border Height="1" Background="{StaticResource RaisedBackground}" Margin="8,14" />
          <DockPanel>
            <Button Name="SidebarChooseFolder" DockPanel.Dock="Right" Content="+" ToolTip="Choose music folder" AutomationProperties.Name="Choose music folder" Background="Transparent" Padding="8" />
            <Button Name="LibraryNav" Style="{StaticResource SidebarEntry}" ToolTip="Open library">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="21" Height="21" Margin="0,0,12,0">
                  <Path Data="{DynamicResource library_music_outlined}" Fill="{StaticResource SecondaryText}" />
                </Viewbox>
                <TextBlock Text="Your library" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </DockPanel>
        </StackPanel>
        <StackPanel Name="SidebarTools" Grid.Row="1" Margin="4,12,4,8">
          <Border Background="{StaticResource RaisedBackground}" CornerRadius="16" Padding="12,6" HorizontalAlignment="Left">
            <TextBlock Text="Downloaded" FontSize="11" />
          </Border>
          <TextBox Name="SidebarFilter" Background="Transparent" FontSize="12" Padding="4,12" AutomationProperties.Name="Find in sidebar library" ToolTip="Find a saved track" />
          <TextBlock Name="SidebarCount" Text="Your saved music" Foreground="{StaticResource SecondaryText}" FontSize="11" />
        </StackPanel>
        <Grid Grid.Row="2">
          <ListBox Name="SidebarTracks" ItemTemplate="{StaticResource SidebarTrack}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
          <TextBlock Name="SidebarEmpty" Text="Your music lives here.&#xA;Choose a folder to get started." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" Margin="12,24" VerticalAlignment="Top" />
        </Grid>
        <TextBlock Name="SidebarNote" Grid.Row="3" Text="YOUR SOUND, IN FOCUS" Foreground="{StaticResource SecondaryText}" FontSize="9" Margin="12,16,0,4" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBackground}" CornerRadius="{StaticResource PanelRadius}" Margin="8,0,8,8" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="24,20,24,14">
          <TextBlock Name="PageTitle" Text="Home" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="POCKET MUSIC" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource SecondaryText}" />
        </DockPanel>
        <Grid Grid.Row="1">
          <ScrollViewer Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,18,24">
            <StackPanel>
              <WrapPanel Margin="0,0,0,22">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="18" Padding="16,8" Margin="0,0,8,0">
                  <TextBlock Text="For you" Foreground="{StaticResource AppBackground}" FontSize="12" />
                </Border>
                <Button Name="HeroLibrary" Content="Saved music" Padding="16,8" Margin="0,0,8,0" />
                  <Button Name="HeroBrowse" Content="Discover" Padding="16,8" />
                  <Button Name="YouTubeRecommendations" Content="My YouTube picks" Padding="16,8" Margin="8,0,0,0" ToolTip="Load your YouTube account recommendations using an imported session" />
              </WrapPanel>
              <TextBlock Text="Your next great listen" FontSize="26" FontWeight="Bold" Margin="0,0,0,5" />
              <TextBlock Text="Start with a favourite, or find something new." FontSize="13" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,18" />
              <Border Name="RecentEmpty" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                <DockPanel>
                  <Button Name="HomeChooseFolder" DockPanel.Dock="Right" Content="Choose folder" Background="{StaticResource AccentBrush}" Foreground="{StaticResource AppBackground}" VerticalAlignment="Center" />
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Bring your music along" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Add a music folder to start your offline collection." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <ListBox Name="RecentTracks" Tag="2" ItemTemplate="{StaticResource HomeTrackTile}" Margin="-8,0,-8,20" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <DockPanel Margin="0,0,0,14">
                <Button Name="ShowLibrary" DockPanel.Dock="Right" Content="See library" Background="Transparent" Padding="8,4" FontSize="12" />
                <TextBlock Text="Your offline rotation" FontSize="22" FontWeight="Bold" />
              </DockPanel>
              <TextBlock Name="HomeLibraryCount" Text="Your local collection" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,14" />
              <ListBox Name="HomeAlbums" Tag="4" ItemTemplate="{StaticResource AlbumCard}" Margin="-8,0,-8,14" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <Border Background="{StaticResource CardBackground}" CornerRadius="12" Margin="0,0,0,24">
                <Grid Height="110">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="18" VerticalAlignment="Center">
                    <TextBlock Text="A soundtrack for every moment" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Explore a mood below. Keep what you love." Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                  <Border Name="HomeHeroArt" Grid.Column="1" Background="{StaticResource RaisedBackground}" CornerRadius="0,12,12,0" />
                </Grid>
              </Border>
              <TextBlock Text="Find your flow" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" />
              <UniformGrid Columns="2" Margin="0,0,-10,20">
                <Button Name="MoodEnergize" Content="Energize   ↗" Background="{StaticResource MoodEnergy}" HorizontalContentAlignment="Left" Height="58" Margin="0,0,10,10" FontSize="16" FontWeight="SemiBold" />
                <Button Name="MoodWorkout" Content="Workout   ⚡" Background="{StaticResource MoodFocus}" HorizontalContentAlignment="Left" Height="58" Margin="0,0,10,10" FontSize="16" FontWeight="SemiBold" />
                <Button Name="MoodRelax" Content="Relax   ☾" Background="{StaticResource MoodCalm}" HorizontalContentAlignment="Left" Height="58" Margin="0,0,10,10" FontSize="16" FontWeight="SemiBold" />
                <Button Name="MoodFeelGood" Content="Feel good   ♡" Background="{StaticResource MoodNight}" HorizontalContentAlignment="Left" Height="58" Margin="0,0,10,10" FontSize="16" FontWeight="SemiBold" />
              </UniformGrid>
              <TextBlock Text="A change of pace" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" />
              <UniformGrid Columns="3" Margin="0,0,-10,0">
                <Button Name="DiscoverPiano" Background="{StaticResource MoodFocus}" Padding="16" Margin="0,0,10,0" HorizontalContentAlignment="Stretch">
                  <StackPanel>
                    <TextBlock Text="☾" FontSize="44" Margin="0,0,0,22" />
                    <TextBlock Text="Quiet piano" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Slow things down" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                  </StackPanel>
                </Button>
                <Button Name="DiscoverJazz" Background="{StaticResource MoodEnergy}" Padding="16" Margin="0,0,10,0" HorizontalContentAlignment="Stretch">
                  <StackPanel>
                    <TextBlock Text="♫" FontSize="44" Margin="0,0,0,22" />
                    <TextBlock Text="Jazz sessions" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Find your rhythm" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                  </StackPanel>
                </Button>
                <Button Name="DiscoverAcoustic" Background="{StaticResource MoodCalm}" Padding="16" Margin="0,0,10,0" HorizontalContentAlignment="Stretch">
                  <StackPanel>
                    <TextBlock Text="≈" FontSize="44" Margin="0,0,0,22" />
                    <TextBlock Text="Acoustic" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Keep it simple" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                  </StackPanel>
                </Button>
              </UniformGrid>
            </StackPanel>
          </ScrollViewer>
          <Grid Name="SearchView" Visibility="Collapsed" Margin="24,0,18,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
              <Button Name="SearchCancel" DockPanel.Dock="Right" Content="Cancel search" IsEnabled="False" Padding="12,8" />
              <TextBlock Text="Find your music" FontSize="22" FontWeight="Bold" />
            </DockPanel>
            <TextBlock Name="SearchStatus" Grid.Row="1" Text="Songs, artists or a YouTube link. Your next listen starts above." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,18" />
            <Grid Grid.Row="2">
              <ListBox Name="SearchResults" ItemTemplate="{StaticResource SearchTrackRow}" />
              <StackPanel Name="SearchEmpty" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <TextBlock Text="⌕" FontSize="56" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Name="SearchEmptyTitle" Text="What would you like to hear?" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,10" />
                <TextBlock Name="SearchEmptyHint" Text="Search above to preview a track or save it to your collection." Foreground="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar Name="SearchActivity" Visibility="Collapsed" IsIndeterminate="True" Height="3" Margin="40,24" Foreground="{StaticResource AccentBrush}" />
                <UniformGrid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Name="SearchBrowse" Columns="2" Margin="0,24,0,0">
                  <Button Name="BrowseFocus" Tag="lofi focus music" Content="Focus" Background="{StaticResource MoodFocus}" Margin="4" Padding="16,14" />
                  <Button Name="BrowseCalm" Tag="relaxing piano music" Content="Unwind" Background="{StaticResource MoodCalm}" Margin="4" Padding="16,14" />
                  <Button Name="BrowseJazz" Tag="jazz session music" Content="Jazz" Background="{StaticResource MoodEnergy}" Margin="4" Padding="16,14" />
                  <Button Name="BrowseAcoustic" Tag="acoustic music" Content="Acoustic" Background="{StaticResource MoodNight}" Margin="4" Padding="16,14" />
                </UniformGrid>
              </StackPanel>
            </Grid>
          </Grid>
          <Grid Name="LibraryView" Visibility="Collapsed" Margin="24,0,18,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Name="LibraryChangeFolder" Content="Choose folder" Padding="10,8" Margin="0,0,6,0" />
                <Button Name="RefreshLibrary" Content="Refresh" Padding="10,8" />
              </StackPanel>
              <TextBlock Text="Your saved music" FontSize="22" FontWeight="Bold" />
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,12,0,16">
              <TextBlock Name="LibraryStatus" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
              <DockPanel>
                <ComboBox Name="LibraryFileFormat" SelectedIndex="0" DockPanel.Dock="Right" Width="120" Margin="8,0,0,0" AutomationProperties.Name="Filter library by format"><ComboBoxItem Content="All audio"/><ComboBoxItem Content="MP3"/><ComboBoxItem Content="M4A"/><ComboBoxItem Content="Opus"/><ComboBoxItem Content="FLAC"/><ComboBoxItem Content="WAV"/></ComboBox>
                <ComboBox Name="LibrarySort" SelectedIndex="0" DockPanel.Dock="Right" Width="154" Margin="8,0,0,0" AutomationProperties.Name="Sort library">
                  <ComboBoxItem Content="Recently saved" />
                  <ComboBoxItem Content="Title A-Z" />
                  <ComboBoxItem Content="Title Z-A" />
                </ComboBox>
                <Button Name="LibraryClearFilter" Content="Clear" Visibility="Collapsed" DockPanel.Dock="Right" Padding="10,8" Margin="8,0,0,0" />
                <Grid><TextBox Name="LibraryFilter" ToolTip="Find a saved track or file format" AutomationProperties.Name="Filter library by track name" /><TextBlock Text="Find in your library" Foreground="#B7C5DA" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LibraryFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
              </DockPanel>
            </StackPanel>
            <Grid Grid.Row="2">
              <ListBox Name="LibraryTracks" ItemTemplate="{StaticResource TrackRow}" />
              <StackPanel Name="LibraryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" Margin="24">
                <TextBlock Name="LibraryEmptyTitle" Text="Your library starts here" FontSize="23" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Name="LibraryEmptyHint" Text="Choose a folder with your audio files." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,20" />
                <Button Name="LibraryChooseFolder" Content="Choose music folder" HorizontalAlignment="Center" Background="{StaticResource AccentBrush}" Foreground="{StaticResource AppBackground}" />
              </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="3" Margin="0,16,0,0">
              <Button Name="PlayLocal" Content="Play selected" IsEnabled="False" Margin="0,0,8,0" />
              <Button Name="PlayAllLocal" Content="Play all" Background="{StaticResource AccentBrush}" Foreground="{StaticResource AppBackground}" Margin="0,0,8,0" />
              <Button Name="QueueAllLocal" Content="Add all to queue" /><Button Name="DeleteLocalFile" Content="Delete selected…" Background="Transparent" Foreground="#FFB8C8" Margin="12,0,0,0" IsEnabled="False" />
            </WrapPanel>
          </Grid>
          <Border Name="QueuePanel" Visibility="Collapsed" Background="#172133" BorderBrush="#42516A" BorderThickness="1" CornerRadius="18" Padding="16" Margin="10" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,12">
                <Button Name="QueueClose" Content="✕" DockPanel.Dock="Right" Padding="8,4" Background="Transparent" Foreground="#C9DFFF" FontSize="14" />
                <TextBlock Text="Play Queue" FontSize="20" FontWeight="SemiBold" />
              </DockPanel>
              <ListBox Grid.Row="1" Name="QueueList" ItemTemplate="{StaticResource QueueTrackRow}" />
              <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button Name="QueueClear" Content="Clear queue" DockPanel.Dock="Left" Padding="12,6" Background="#223049" FontSize="12" />
                <TextBlock Name="QueueCountStatus" Text="0 tracks" Foreground="#B7C5DA" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Border Name="DownloadPanel" Grid.Column="2" Grid.Row="1" Visibility="Collapsed" Background="#172133" CornerRadius="12" Margin="0,0,8,8" Padding="20,24,20,20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
          <Button Name="CloseDownloads" Content="×" DockPanel.Dock="Right" Padding="9,3" FontSize="18" Background="Transparent" ToolTip="Close download settings" AutomationProperties.Name="Close download settings" />
          <TextBlock Text="Downloads" FontSize="21" FontWeight="SemiBold" />
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="#223049" CornerRadius="20" Padding="18" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="SELECTED TRACK" FontSize="10" Foreground="#B7C5DA" />
                <TextBlock Name="SelectedTitle" Text="Choose a search result" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,8" />
                <TextBlock Name="SelectedSubtitle" Text="Or paste a video link below" FontSize="12" Foreground="#B7C5DA" TextWrapping="Wrap" />
                <Button Name="SelectedPreview" Content="▶ Preview play" Margin="0,14,0,0" Padding="12,9" ToolTip="Stream in the YouTube player; no audio download" />
                <Button Name="SelectedLocal" Content="Play local copy" IsEnabled="False" Margin="0,6,0,0" Padding="12,9" ToolTip="Play downloaded audio from the selected folder">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                      <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </Border>
            <Expander Header="YouTube video link" Foreground="#B7C5DA" IsExpanded="False" Margin="0,0,0,18">
              <TextBox Name="Url" Margin="0,10,0,0" TextWrapping="Wrap" />
            </Expander>
            <TextBlock Text="Download format" Foreground="#B7C5DA" Margin="0,0,0,8" />
            <ComboBox Name="Format" SelectedIndex="0" FontSize="14" Padding="10">
              <ComboBoxItem Content="MP3" />
              <ComboBoxItem Content="MP4 (video)" ToolTip="Video with audio" />
              <ComboBoxItem Content="M4A" />
              <ComboBoxItem Content="Opus" />
              <ComboBoxItem Content="FLAC" />
              <ComboBoxItem Content="WAV" />
            </ComboBox>
            <TextBlock Text="FLAC and WAV cannot restore source quality." TextWrapping="Wrap" Foreground="#B7C5DA" FontSize="11" Margin="0,8,0,18" />
            <TextBlock Text="Save to" Foreground="#B7C5DA" Margin="0,0,0,8" />
            <TextBox Name="Folder" FontSize="12" TextWrapping="Wrap" />
            <Button Name="Browse" Content="Choose folder" Margin="0,8,0,18" />
            <CheckBox Name="Permission">
              <TextBlock Text="I own this content or have permission to download it." TextWrapping="Wrap" Foreground="#B7C5DA" FontSize="12" />
            </CheckBox>
            <Expander Name="DetailsExpander" Header="Activity details" Foreground="#B7C5DA" Margin="0,14,0,0">
              <TextBox Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" Height="110" Margin="0,8,0,0" />
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
          <Button Name="Start" Content="Download audio" Background="#C9DFFF" Foreground="#101A2B" Margin="0,20,0,8" />
          <Button Name="Cancel" Content="Cancel download" IsEnabled="False" Margin="0,0,0,8">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <ProgressBar Name="Progress" Height="4" Foreground="#C9DFFF" Background="#37303F" Maximum="100" Margin="0,0,0,8" />
          <TextBlock Name="Status" Text="Ready when you are" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#B7C5DA" FontSize="12" Margin="0,0,0,12" />
            <Button Name="OpenYouTubeVideo" Content="Open video on YouTube" Padding="12,7" FontSize="12" Margin="0,0,0,8" ToolTip="Check playback or complete verification in your browser. Browser sign-in is not shared with this downloader." />
            <Button Name="OpenFolder" Content="Open download folder" Padding="12,7" FontSize="12" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Name="NowPlayingPanel" Grid.Row="1" Grid.Column="3" Background="{StaticResource PanelBackground}" CornerRadius="{StaticResource PanelRadius}" Margin="0,0,8,8" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel Margin="0,0,0,20">
            <Button Name="CloseNowPlaying" DockPanel.Dock="Right" Content="×" Background="Transparent" Padding="8,0" ToolTip="Close now playing" AutomationProperties.Name="Close now playing" />
            <TextBlock Text="Now playing" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <Border Height="240" Background="{StaticResource RaisedBackground}" CornerRadius="12">
            <Grid>
              <Viewbox Width="78" Height="78">
                <Path Data="{DynamicResource music_note}" Fill="{StaticResource AccentBrush}" />
              </Viewbox>
              <Image Name="NowArtwork" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <TextBlock Name="NowTitle" Text="Make room for music" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,22,0,8" />
          <TextBlock Name="NowSubtitle" Text="Play a saved track or find a new favourite." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="13" />
          <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="14" Margin="0,22,0,16">
            <StackPanel>
              <TextBlock Name="NowSource" Text="Ready to listen" FontWeight="SemiBold" />
              <TextBlock Name="NowStatus" Text="Playback controls stay with you below." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <WrapPanel>
            <Button Name="NowToggle" Content="Play / pause" Background="{StaticResource AccentBrush}" Foreground="{StaticResource AppBackground}" Padding="14,8" Margin="0,0,8,0" IsEnabled="False" />
            <Button Name="NowQueue" Content="Queue" Padding="14,8" /><Button Name="ExpandListening" Content="Expand player" Padding="14,8" Margin="0,8,0,0" />
          </WrapPanel>
          <TextBlock Text="Coming up" FontSize="17" FontWeight="SemiBold" Margin="0,28,0,12" />
          <TextBlock Name="NowNextEmpty" Text="Add a few tracks to your queue." Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" />
          <ItemsControl Name="NowNextTracks">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,8">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                  <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
