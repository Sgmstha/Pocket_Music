<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Background="#282230" CornerRadius="24,24,0,0" Padding="22,12,24,10">
 <Border.Resources><Style TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="18"><Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#CEC1FF" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#E0D4FF"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#655772" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style></Border.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
  <Grid Margin="0,0,22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="14" Background="#494057"><TextBlock Text="♫" Foreground="#DDD0FF" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Name="PlayerTitle" Text="Your music, right here" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Name="PlayerStatus" Text="Choose a saved track in Library" Foreground="#C0B3CF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></Grid>
  <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Name="PlayerPrevious" Content="⏮" ToolTip="Previous track; restart after 3 seconds" Padding="16,8" Background="Transparent" IsEnabled="False"/><Button Name="PlayerToggle" Content="▶" ToolTip="Play or pause" Padding="23,8" Background="#CEC1FF" Foreground="#251C35" IsEnabled="False"/><Button Name="PlayerNext" Content="⏭" ToolTip="Next track" Padding="16,8" Background="Transparent" IsEnabled="False"/></StackPanel><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="47"/><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/></Grid.ColumnDefinitions><TextBlock Name="PlayerElapsed" Text="0:00" FontSize="11" Foreground="#C0B3CF" VerticalAlignment="Center"/><Slider Name="PlayerSeek" Grid.Column="1" Minimum="0" Maximum="1" Value="0" IsEnabled="False" IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="Seek through the track"/><TextBlock Name="PlayerDuration" Grid.Column="2" Text="0:00" FontSize="11" Foreground="#C0B3CF" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel>
  <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center"><DockPanel><TextBlock Text="Volume" FontSize="11" Foreground="#C0B3CF"/><TextBlock Name="PlayerVolumeLabel" Text="60%" FontSize="11" Foreground="#C0B3CF" HorizontalAlignment="Right"/></DockPanel><Slider Name="PlayerVolume" Minimum="0" Maximum="1" Value="0.6" SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True" Margin="0,9,0,0" ToolTip="Playback volume"/></StackPanel>
 </Grid>
</Border>
