<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
  <ImageView android:id="@+id/widget_art" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop" android:src="@drawable/ic_music" android:contentDescription="Track artwork"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="4dp">
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pocket Music" android:textColor="#F1F5FF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
   <TextView android:id="@+id/widget_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved music controls" android:textColor="#B7C5DA" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center">
  <ImageButton android:id="@+id/widget_previous" android:layout_width="64dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_previous" android:contentDescription="Previous track"/>
  <ImageButton android:id="@+id/widget_toggle" android:layout_width="80dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_play" android:contentDescription="Play or pause"/>
  <ImageButton android:id="@+id/widget_next" android:layout_width="64dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_next" android:contentDescription="Next track"/>
 </LinearLayout>
</LinearLayout>
