<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Visibility="Collapsed">
  <Grid.Background>
    <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.8" RadiusY="0.8">
      <GradientStop Color="#16243D" Offset="0" />
      <GradientStop Color="#090E17" Offset="1" />
    </RadialGradientBrush>
  </Grid.Background>
 <Grid.Resources>
    <Style TargetType="Slider">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="16">
              <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="#C9DFFF" CornerRadius="2" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="10" Height="10">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#C9DFFF" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="#42516A" CornerRadius="2" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F5FF"/></Style>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#B7C5DA"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="40" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C9DFFF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel Margin="24,14"><Button Name="FocusClose" Content="⌄  Back" DockPanel.Dock="Left" AutomationProperties.Name="Close focused player"/><Button Name="FocusDelete" Content="⋯" FontSize="24" DockPanel.Dock="Right" ToolTip="Track options"/><TextBlock Text="NOW PLAYING" FontSize="12" Foreground="#B7C5DA" HorizontalAlignment="Center" VerticalAlignment="Center"/></DockPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid MaxWidth="1100" Margin="42,24,42,36" VerticalAlignment="Center">
 <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".95*"/></Grid.ColumnDefinitions>
 <Viewbox MaxWidth="430" MaxHeight="430" Margin="0,0,52,0" Stretch="Uniform">
   <Grid Width="410" Height="410">
     <Border Width="380" Height="380" Background="#1D2E4A" CornerRadius="28" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border.Effect><BlurEffect Radius="36" KernelType="Gaussian"/></Border.Effect>
     </Border>
     <Border Width="400" Height="400" Background="#141D2C" BorderBrush="#253550" BorderThickness="1" CornerRadius="20" ClipToBounds="True">
       <Grid><TextBlock Text="♫" FontSize="96" Foreground="#C9DFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Name="FocusArt" Stretch="UniformToFill"/></Grid>
     </Border>
   </Grid>
 </Viewbox>
 <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="500">
 <TextBlock Name="FocusSource" Text="SAVED AUDIO" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,16"/>
 <TextBlock Name="FocusTitle" FontSize="34" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" MaxHeight="112" TextTrimming="CharacterEllipsis"/>
 <TextBlock Name="FocusArtist" Foreground="#94A3B8" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,26"/>
 <Slider Name="FocusSeek" Maximum="1" Minimum="0" IsMoveToPointEnabled="True" AutomationProperties.Name="Focused playback position" Height="30"/>
 <DockPanel Margin="0,0,0,28"><TextBlock Name="FocusElapsed" Text="0:00" DockPanel.Dock="Left" FontSize="12" Foreground="#94A3B8"/><TextBlock Name="FocusDuration" Text="0:00" DockPanel.Dock="Right" FontSize="12" Foreground="#94A3B8"/><TextBlock Name="FocusOrder" TextAlignment="Center" FontSize="12" Foreground="#94A3B8"/></DockPanel>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
 <Button Name="FocusShuffle" Content="&#xE8B1;" FontFamily="Segoe MDL2 Assets" ToolTip="Shuffle" AutomationProperties.Name="Shuffle"/>
 <Button Name="FocusPrevious" Content="&#xE892;" FontSize="23" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="Previous track"/>
 <Button Name="FocusToggle" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="26" Width="76" Height="76" Background="#60A5FA" Foreground="#090E17" Margin="14,0" AutomationProperties.Name="Play"/>
 <Button Name="FocusNext" Content="&#xE893;" FontSize="23" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="Next track"/>
 <Button Name="FocusRepeat" Content="&#xE8EE;" FontFamily="Segoe MDL2 Assets" ToolTip="Repeat" AutomationProperties.Name="Repeat"/>
 </StackPanel>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
   <Button Name="FocusTimer" Content="Timer" Margin="4,0" Padding="14,8"/>
   <Button Name="FocusQueue" Content="Queue" Margin="4,0" Padding="14,8"/>
   <Button Name="FocusLyrics" Content="Lyrics" Margin="4,0" Padding="14,8" ToolTip="Show synced lyrics"/>
   <Button Name="FocusSound" Content="Sound" Margin="4,0" Padding="14,8"/>
 </StackPanel>
 <Border Name="FocusLyricsPanel" Visibility="Collapsed" Background="#F00F1726" BorderBrush="#253752" BorderThickness="1" CornerRadius="20" Padding="20,16" Margin="0,16,0,0" MaxHeight="300">
   <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
       <TextBlock Text="LYRICS" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
       <Button Name="FocusLyricsClose" Content="Close" HorizontalAlignment="Right" Padding="10,4" MinWidth="48" MinHeight="24" FontSize="11" Background="#1E2B3E" Foreground="#94A3B8"/>
     </DockPanel>
     <ScrollViewer Name="FocusLyricsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <TextBlock Name="FocusLyricsText" Text="Loading lyrics..." FontSize="15" Foreground="#F1F5FF" TextWrapping="Wrap" LineHeight="28" TextAlignment="Center"/>
     </ScrollViewer>
   </DockPanel>
 </Border>
 <Slider Name="FocusVolume" Visibility="Collapsed" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Height="36" Margin="30,8" AutomationProperties.Name="Focused volume"/>
 <TextBlock Name="FocusStatus" FontSize="12" Foreground="#B7C5DA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
 </StackPanel></Grid></ScrollViewer>
</Grid>